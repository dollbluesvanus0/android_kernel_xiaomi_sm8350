# Xiaomi Mi 11 (venus) kernel build defaults.
# The GitHub Actions workflow exposes these as workflow_dispatch inputs.

# LineageOS-derived SM8350 tree used by the Android 17 venus port.
KERNEL_SOURCE=https://github.com/RobertGarciaa/android_kernel_xiaomi_sm8350.git
KERNEL_SOURCE_REF=seventeen
KERNEL_CONFIG=vendor/venus_QGKI.config
KERNEL_BASE_CONFIG=gki_defconfig

# The Mi 11 uses a 5.4 non-GKI kernel. ReSukiSU keeps a manual-hook path for
# old non-GKI kernels; this is the default for this device.
KSU_SETUP_SOURCE=https://raw.githubusercontent.com/ReSukiSU/ReSukiSU/main/kernel/setup.sh
KSU_REF=main
KSU_MANUAL_HOOK=1

# Android 11's official AOSP kernel toolchain.
CLANG_VERSION=clang-r416183b
CLANG_BRANCH=android12-release
GCC_VERSION=4.9
GCC_BRANCH=android11-release

ANYKERNEL_SOURCE=https://github.com/osm0sis/AnyKernel3.git
ANYKERNEL_REF=master

ARCH=arm64
SUBARCH=arm64
LOCALVERSION=-venus-resukisu
